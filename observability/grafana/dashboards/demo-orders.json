{
  "uid": "demo-orders",
  "title": "02 Order Flow and SQL",
  "description": "Compare Prometheus operations with PostgreSQL business records",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "timezone": "browser",
  "tags": [
    "local-demo"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Orders created per second (PromQL)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(demo_orders_created_total[5m]))",
          "legendFormat": "{{service_name}} {{result}} {{queue}} {{consumergroup}} {{job}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Pending outbox events (SQL)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "SELECT count(*) AS pending_events FROM outbox WHERE published_at IS NULL",
          "format": "table",
          "rawQuery": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 81,
      "title": "Orders by status (SQL)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "SELECT status, count(*) AS orders FROM orders GROUP BY status ORDER BY status",
          "format": "table",
          "rawQuery": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 93,
      "title": "Recent orders (SQL)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "SELECT created_at, id, product_id, quantity, amount_cents, status FROM orders ORDER BY created_at DESC LIMIT 20",
          "format": "table",
          "rawQuery": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 161,
      "title": "Fulfillment time by order (SQL)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "SELECT id, extract(epoch FROM fulfilled_at - created_at) AS fulfillment_seconds FROM orders WHERE fulfilled_at IS NOT NULL ORDER BY fulfilled_at DESC LIMIT 20",
          "format": "table",
          "rawQuery": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 173,
      "title": "Outbox oldest pending age (SQL)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "SELECT COALESCE(extract(epoch FROM now() - min(created_at)), 0) AS seconds FROM outbox WHERE published_at IS NULL",
          "format": "table",
          "rawQuery": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
