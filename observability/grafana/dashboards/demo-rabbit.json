{
  "uid": "demo-rabbit",
  "title": "03 RabbitMQ Fulfillment",
  "description": "Queue and worker health",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "timezone": "browser",
  "tags": [
    "local-demo"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Ready tasks (PromQL)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_queue_messages_ready{queue=~\"fulfillment.*\"}",
          "legendFormat": "{{service_name}} {{result}} {{queue}} {{consumergroup}} {{job}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Unacknowledged tasks (PromQL)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_queue_messages_unacked{queue=\"fulfillment\"}",
          "legendFormat": "{{service_name}} {{result}} {{queue}} {{consumergroup}} {{job}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 81,
      "title": "Fulfilled orders per second (PromQL)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(demo_orders_fulfilled_total[5m]))",
          "legendFormat": "{{service_name}} {{result}} {{queue}} {{consumergroup}} {{job}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 93,
      "title": "Fulfillment failures per second (PromQL)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(demo_fulfillment_failures_total[5m])) or vector(0)",
          "legendFormat": "{{service_name}} {{result}} {{queue}} {{consumergroup}} {{job}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
